# OpenRouter
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/free
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Application
LLM_TEMPERATURE=0
LLM_TIMEOUT_SECONDS=30

# Langfuse
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://cloud.langfuse.com

# Agent to Cube
CUBE_API_URL=http://cube:4000/cubejs-api/v1
CUBE_API_TOKEN=

# Cube to ClickHouse
CUBEJS_DB_TYPE=clickhouse
CUBEJS_DB_HOST=clickhouse
CUBEJS_DB_PORT=8123
CUBEJS_DB_NAME=marketing
CUBEJS_DB_USER=cube_reader
CUBEJS_DB_PASS=
CUBEJS_DEV_MODE=true

# ClickHouse initialization
CLICKHOUSE_DB=marketing
CLICKHOUSE_USER=cube_reader
CLICKHOUSE_PASSWORD=

# Application
APP_ENV=development
LOG_LEVEL=INFO
REQUEST_TIMEOUT_SECONDS=15
